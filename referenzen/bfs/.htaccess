# BFS – Referenz (statische Seite, PROJEKT EX). Nur fuer IONOS/Apache relevant, GitHub Pages ignoriert diese Datei.
# Erzeugt von tools/branchen/referenz_uebernehmen.py. Nur eigene Dateien (Schriften und Skripte lokal), keine Drittanbieter.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' blob: data:; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self' mailto:; manifest-src 'self'; upgrade-insecure-requests; frame-ancestors 'none'"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
