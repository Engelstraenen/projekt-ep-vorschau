# =====================================================================
#  PROJEKT EP – .htaccess für IONOS Webhosting (Apache)
#  Domain: https://projekt-ep.de (ohne www, nur HTTPS)
#  ENTWURF im Branch audit-fixes. Erst beim Umzug zu IONOS hochladen.
#  Nach Änderungen an Inline-Skripten: python3 tools/csp.py (aktualisiert CSP unten)
# =====================================================================

Options -Indexes -MultiViews
ServerSignature Off
AddDefaultCharset UTF-8
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) HTTP -> HTTPS und www -> ohne www (eine Variante, ein 301-Sprung)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://projekt-ep.de%{REQUEST_URI} [R=301,L,NE]

  # 2) Interne Dateien nie ausliefern (Repo-Reste, Werkzeuge, Doku, Vorschauen)
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^(tools|docs|node_modules|steak-seite|hq-showcase|\.github)(/|$) - [R=404,L]
  RewriteRule \.(md|py|mjs\.map|lock|log|sh|yml|yaml|json\.bak)$ - [R=404,L]
  RewriteRule ^(package(-lock)?\.json)$ - [R=404,L]

  # 3) Alte Adressen dauerhaft umleiten
  RewriteRule ^leistungen/ki-automatisierung(\.html)?$ /leistungen/automatisierung-chatbots [R=301,L]
  RewriteRule ^leistungen/ki-werbeclips(\.html)?$ /leistungen/werbeclips [R=301,L]

  # 4) Saubere URLs: /faq -> faq.html (passend zu den Canonical-Tags)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # HSTS: erst aktivieren, wenn HTTPS inkl. Zertifikat für projekt-ep.de UND www.projekt-ep.de sicher läuft.
  # Start mit 1 Jahr. "preload" erst nach bewusster Entscheidung (schwer rückgängig zu machen).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), autoplay=(self), camera=(), display-capture=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always unset X-Powered-By
  Header unset X-Powered-By
  # CSP-BEGIN
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-/gHcORVryR88gRVVgXAuiU8nevyapI9DApdVqBtXaic=' 'sha256-2X3eNqNDknJ1dqOgeyF9Ah9X7P2T3UeSdwIubIqlyTA=' 'sha256-5wotKctcDSp8tYTIUEW2GGoj+2UA/7aMKKtNcXBBpj4=' 'sha256-6SYSAYD/XmJo0bydQxoSp4QK6ZYYKeTaHk5n2UTLR9s=' 'sha256-8fPFeCuLiKkRrSWg2eHTp8s4hW0kiZMxwlKjE8z2mVY=' 'sha256-GNH/OzHntoG96nZw+hCSKjYqkJ5NLSXTvXEReWSPJF8=' 'sha256-ORYTzHdG9jJqWlDOTrWg8cvAnrL+YPXKAFnyDkv7gAs=' 'sha256-bmhfAvXSOhcD/jjg9LeS8ibyikdbaYrMiunewYG5ebg=' 'sha256-hjVn+IRsqvrt8bMHeAuDaoUehRtmyqdrzqX5qm/5igI=' 'sha256-tailY8JBFgwNmdhLzbQ2iAuA80ZU19ZDvkmOYibwUZQ='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests; frame-ancestors 'none'"
  # CSP-END

  # Caching: HTML kurz, Assets lang
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|mjs|webp|jpg|jpeg|png|svg|mp4|webm|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType text/javascript .mjs
  AddType image/webp .webp
  AddType video/mp4 .mp4
</IfModule>

# Kontaktformular: nur POST erlaubt (Prüfung zusätzlich in kontakt.php)
<Files "kontakt.php">
  <LimitExcept POST>
    Require all denied
  </LimitExcept>
</Files>
