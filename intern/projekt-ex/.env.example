# Kopieren nach .env und selbst befüllen. Diese Datei enthält keine Geheimnisse.
# SESSION_SECRET erzeugen:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=data/projekt-ex.sqlite
NODE_ENV=development
# Hinter HTTPS auf 1 setzen. Bei NODE_ENV=production ist das Pflicht.
COOKIE_SECURE=

# Leer lassen: Webhooks antworten 503, die Oberfläche zeigt „Nicht konfiguriert“.
# Niemals echte Zugangsdaten ins Repository schreiben.
TELEPHONE_WEBHOOK_SECRET=
META_APP_SECRET=
META_VERIFY_TOKEN=
EMAIL_WEBHOOK_SECRET=
WEBCHAT_INGEST_SECRET=
